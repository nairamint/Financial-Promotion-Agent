# Environment Variables Template
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to version control

# ==================================================
# Gemini API Configuration
# ==================================================
# Get your API key from: https://ai.google.dev/
GEMINI_API_KEY=your_gemini_api_key_here

# ==================================================
# Google Cloud Platform (Audit Trail Storage)
# ==================================================
GCP_PROJECT_ID=your_gcp_project_id
GCS_AUDIT_BUCKET=cfpa-evidence-archive
GCS_BUCKET_RETENTION_YEARS=7

# ==================================================
# FCA Register API
# ==================================================
# FCA Register API credentials (if using real API)
FCA_REGISTER_API_KEY=your_fca_api_key_here

# ==================================================
# Cryptographic Keys (CRITICAL SECURITY)
# ==================================================
# Generate with: openssl rand -hex 32
# NEVER use the same key in development and production
# Rotate keys regularly and maintain key version history

AUDIT_SECRET_KEY=generate_with_openssl_rand_hex_32
AUDIT_BACKUP_KEY=generate_with_openssl_rand_hex_32_different_from_above

# ==================================================
# Environment Configuration
# ==================================================
NODE_ENV=development

# ==================================================
# Optional: Monitoring & Analytics
# ==================================================
# SENTRY_DSN=your_sentry_dsn_here
# GA_TRACKING_ID=your_google_analytics_id
